{
  "expo": {
    "name": "神罚",
    "slug": "strict-ledger",
    "version": "0.7.0",
    "orientation": "portrait",
    "scheme": "strictledger",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#2F4A6D"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.strictledger.app",
      "versionCode": 7,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F3F6FB"
      },
      "permissions": [
        "POST_NOTIFICATIONS",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_DATA_SYNC"
      ]
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#121212",
      "dark": {
        "image": "./assets/splash-icon.png",
        "backgroundColor": "#121212"
      }
    }
  }
}
