    "drizzle-orm": "^0.45.4",
    "expo": "^58.0.25",
    "expo-asset": "~58.0.21",
    "expo-crypto": "~58.0.8",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.12",
    "expo-haptics": "^58.0.8",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-sqlite": "~58.0.17",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gifted-charts": "^1.4.81",
    "react-native-mmkv": "^4.3.2",
    "react-native-reanimated": "^4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "^19.3.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js"
    ],
    "transform": {
      "^.+\\.(ts|tsx)$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    },
    "testMatch": [
      "**/*.test.ts"
    ]
