    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "ios": "expo run:ios",
    "package:magisk": "powershell -ExecutionPolicy Bypass -File scripts/package-magisk.ps1"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "^15.0.2",
